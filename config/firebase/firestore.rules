rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Allow read for notifications belonging to the user (userId as number in data)
      allow read: if true; // Relax for now since you're using JWT auth via backend
      
      // Allow creation of notifications
      allow create: if true;
      
      // Users can update notifications
      allow update: if true;
      
      // Users can delete notifications
      allow delete: if true;
    }
    
    // Conversations collection
    match /conversations/{conversationId} {
      // Allow read for all authenticated users (your backend handles auth)
      allow read: if true;
      
      // Allow creating conversations
      allow create: if true;
      
      // Allow updating conversations
      allow update: if true;
      
      // Allow deletion
      allow delete: if true;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Allow read for messages
        allow read: if true;
        
        // Allow create messages
        allow create: if true;
        
        // Allow update messages
        allow update: if true;
        
        // Allow delete messages
        allow delete: if true;
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
