{
  "expo": {
    "name": "Dentify",
    "slug": "dentify-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dentify",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#14B8A6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dentify.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show nearby dentists and clinics."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dentify.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#14B8A6"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Dentify to use your location to show nearby dentists and clinics."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
