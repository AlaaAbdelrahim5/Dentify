# ================================
# Dentify Mobile API Configuration
# ================================
#
# IMPORTANT: Choose the correct URL based on your setup:
#
# 1. iOS Simulator:     http://localhost:5000/api
# 2. Android Emulator:  http://10.0.2.2:5000/api
# 3. Physical Device:   http://YOUR_COMPUTER_IP:5000/api
#
# To find your IP address:
# - Windows: Open Command Prompt and run: ipconfig
# - Mac/Linux: Open Terminal and run: ifconfig
# - Look for "IPv4 Address"
#
# Current Configuration:

EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_IP:5000/api

# ================================
# Alternative Configurations
# ================================
# Uncomment the line you need:
#
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api

# ================================
# Firebase Configuration
# ================================
# Get these values from your Firebase Console:
# https://console.firebase.google.com/
#
# 1. Go to Project Settings > General
# 2. Scroll down to "Your apps" section
# 3. Select your web app or create one
# 4. Copy the config values
#

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here
