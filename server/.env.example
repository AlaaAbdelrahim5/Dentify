# ================================
# Dentify Server Configuration
# ================================

# ================================
# Database Configuration
# ================================
# PostgreSQL connection strings
# Replace with your actual database credentials
#
# For Supabase:
# - Get these from your Supabase project settings
# - Database Settings > Connection String
# - Use "Transaction" mode for DIRECT_URL
# - Use "Session" mode for DATABASE_URL (with pgbouncer=true)
#

DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:port/database"

# ================================
# Server Configuration
# ================================
PORT=5000
NODE_ENV=development

# ================================
# JWT Configuration
# ================================
# Generate a secure random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ================================
# Firebase Admin Configuration
# ================================
# Get this from your Firebase project settings
# https://console.firebase.google.com/
#
# Project Settings > General > Storage bucket
#

FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ================================
# Firebase Client Configuration (for service worker)
# ================================
# These values are served to the client-side service worker
# Get them from Firebase Console > Project Settings > General > Your apps
#

FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# ================================
# Email Configuration
# ================================
# Email for sending password reset emails
# This should be a Gmail account or other SMTP-compatible email
# For Gmail, you need to generate an App Password:
# 1. Go to your Google Account settings
# 2. Security > 2-Step Verification (enable if not already)
# 3. Security > App passwords
# 4. Generate a new app password for "Mail"
# 5. Use that 16-character password here
#

EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Client URL for password reset links
# This is the URL of your frontend application
CLIENT_URL=http://localhost:5173

# ================================
# Email Service Configuration
# ================================
# Email service provider (gmail, outlook, yahoo, etc.)
# See nodemailer documentation for supported services
EMAIL_SERVICE=gmail

# ================================
# Database Connection Timeout
# ================================
# Timeout for database connection on server startup (in milliseconds)
# Default: 10000 (10 seconds)
DB_CONNECTION_TIMEOUT=10000

# ================================
# Query Timeout Configuration
# ================================
# Timeout for sequence sync queries (in milliseconds)
# Default: 5000 (5 seconds)
QUERY_TIMEOUT=5000

# ================================
# Application Configuration
# ================================
# Application name used in emails, 2FA, and API responses
APP_NAME=Dentify

# Request body size limit (for JSON and URL encoded data)
# Increase this for large file uploads or base64 images
# Supports formats like '100mb', '50mb', '10mb'
# Default: 100mb for medical files (DICOM, images, etc.)
REQUEST_BODY_LIMIT=100mb

# Two-factor authentication secret length
# Default: 32 (recommended for security)
TWO_FACTOR_SECRET_LENGTH=32

# ================================
# Security Configuration
# ================================
# Bcrypt salt rounds for password hashing
# Higher number = more secure but slower
# Recommended: 10-12 for production
# Default: 10
BCRYPT_SALT_ROUNDS=10

# Password reset token expiry time in milliseconds
# Default: 3600000 (1 hour = 60 * 60 * 1000)
# Common values:
#   - 1800000 = 30 minutes
#   - 3600000 = 1 hour
#   - 7200000 = 2 hours
PASSWORD_RESET_TOKEN_EXPIRY=3600000

# Random bytes length for generating reset tokens
# Default: 32 (recommended for security)
RESET_TOKEN_BYTES_LENGTH=32
# ================================
# File Upload Configuration
# ================================
# Maximum file size for profile images (in bytes)
# Default: 5242880 (5MB = 5 * 1024 * 1024)
# Common values:
#   - 2097152 = 2MB
#   - 5242880 = 5MB
#   - 10485760 = 10MB
PROFILE_IMAGE_MAX_SIZE=5242880

# Maximum file size for radiology/medical imaging files (in bytes)
# Default: 52428800 (50MB = 50 * 1024 * 1024)
# Common values:
#   - 10485760 = 10MB
#   - 52428800 = 50MB
#   - 104857600 = 100MB
RADIOLOGY_FILE_MAX_SIZE=52428800