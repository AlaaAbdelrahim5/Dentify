# ================================
# Dentify Server Configuration
# ================================

# ================================
# Database Configuration
# ================================
# PostgreSQL connection strings
# Replace with your actual database credentials
#
# For Supabase:
# - Get these from your Supabase project settings
# - Database Settings > Connection String
# - Use "Transaction" mode for DIRECT_URL
# - Use "Session" mode for DATABASE_URL (with pgbouncer=true)
#

DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:port/database"

# ================================
# Server Configuration
# ================================
PORT=5000
NODE_ENV=development

# ================================
# JWT Configuration
# ================================
# Generate a secure random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ================================
# Firebase Admin Configuration
# ================================
# Get this from your Firebase project settings
# https://console.firebase.google.com/
#
# Project Settings > General > Storage bucket
#

FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ================================
# Email Configuration
# ================================
# Email for sending password reset emails
# This should be a Gmail account or other SMTP-compatible email
# For Gmail, you need to generate an App Password:
# 1. Go to your Google Account settings
# 2. Security > 2-Step Verification (enable if not already)
# 3. Security > App passwords
# 4. Generate a new app password for "Mail"
# 5. Use that 16-character password here
#

EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Client URL for password reset links
# This is the URL of your frontend application
CLIENT_URL=http://localhost:5173
