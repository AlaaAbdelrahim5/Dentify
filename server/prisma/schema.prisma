// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =======================
//        MODELS
// =======================

// User model
model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  password     String
  phone        String?
  role         UserRole
  profileImage String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  admin     Admin?
  clinic    Clinic?
  dentist   Dentist?
  secretary Secretary?
  patient   Patient?
  radiology RadiologyCenter?
}

// Admin model
model Admin {
  userId    Int     @id
  firstName String
  lastName  String
  gender    Gender?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Clinic model
model Clinic {
  userId             Int      @id
  clinicName         String
  registrationNumber String
  city               String
  location           String?
  coordinates        String?
  website            String?
  description        String?
  servicesAvailable  String[]
  workingHours       Json?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dentists     Dentist[]
  secretaries  Secretary[]
  appointments Appointment[]
}

// Dentist model
model Dentist {
  userId              Int      @id
  firstName           String
  lastName            String
  licenseNumber       String
  specialization      String[]
  birthDate           DateTime
  gender              Gender?
  city                String
  clinicId            Int
  workingHours        Json? // [{ day, start, end, breaks: [...] }]
  appointmentDuration Int // in minutes
  socialLinks         Json? // { facebook:'', instagram:'', whatsapp:'', tiktok:'' }

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic       Clinic             @relation(fields: [clinicId], references: [userId])
  appointments Appointment[]
  treatments   Treatment[]
  radiologyReq RadiologyRequest[]
}

// Secretary model
model Secretary {
  userId    Int      @id
  firstName String
  lastName  String
  birthDate DateTime
  gender    Gender?
  city      String
  clinicId  Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [userId])
}

// Patient model
model Patient {
  userId    Int      @id
  firstName String
  lastName  String
  gender    Gender?
  birthDate DateTime
  city      String

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  treatments        Treatment[]
  payments          Payment[]
  radiologyRequests RadiologyRequest[]
}

// Radiology Center model
model RadiologyCenter {
  userId             Int      @id
  centerName         String
  registrationNumber String
  website            String?
  city               String
  location           String?
  coordinates        String?
  description        String?
  workingHours       Json?
  supportedTypes     String[] // ["X-ray","CT","3D",...]

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  radiologyRequests RadiologyRequest[]
}

// Appointment model
model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int
  dentistId       Int
  clinicId        Int
  appointmentDate DateTime // date of visit
  startTime       DateTime // exact start timestamp
  endTime         DateTime // start + duration
  status          AppointmentStatus @default(PENDING)
  patientNotes    String? // patient request / reason
  treatmentId     Int? // optional: link to Treatment
  sessionNotes    String? // dentist notes for that session
  sessionCost     Float? // cost for that session

  patient   Patient    @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  dentist   Dentist    @relation(fields: [dentistId], references: [userId], onDelete: Cascade)
  clinic    Clinic     @relation(fields: [clinicId], references: [userId])
  treatment Treatment? @relation(fields: [treatmentId], references: [id])
}

// Treatment model
model Treatment {
  id               Int             @id @default(autoincrement())
  patientId        Int
  dentistId        Int
  treatmentType    String // e.g. "Root Canal", "Extraction"
  description      String?
  status           TreatmentStatus @default(IN_PROGRESS)
  createdAt        DateTime        @default(now())
  totalAmount      Float           @default(0)
  treatmentDiscount Float          @default(0) // Total discount applied to treatment from payments
  paidAmount       Float           @default(0)
  notes            String?

  // Teeth status list for this treatment.
  // [{ toothNumber: 12, conditionStatus:"Cavity", priority:"High", diagnosedDate:"2025-10-27", notes:"Deep decay" }, ...]
  teethStatus Json?

  // Prescriptions list for this treatment.
  // [{ id: "uuid", prescriptionNumber: "RX-2024-001", prescriptionDate: "2024-12-01", medications: [...], createdAt: "...", createdBy: dentistId }]
  prescriptions Json?

  patient       Patient            @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  dentist       Dentist            @relation(fields: [dentistId], references: [userId], onDelete: Cascade)
  appointments  Appointment[]
  payments      Payment[]
  radiologyReqs RadiologyRequest[]
}

// Payment model
model Payment {
  id          Int           @id @default(autoincrement())
  treatmentId Int
  amount      Float
  discount    Float         @default(0) // Payment-specific discount
  method      PaymentMethod
  paymentDate DateTime      @default(now())
  notes       String?

  treatment     Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  Patient       Patient?  @relation(fields: [patientUserId], references: [userId])
  patientUserId Int?
}

// Radiology Request model
model RadiologyRequest {
  id                Int           @id @default(autoincrement())
  patientId         Int
  dentistId         Int
  radiologyCenterId Int
  treatmentId       Int?
  requestDate       DateTime      @default(now())
  imagingType       String // "X-ray", "CT", "3D", etc.
  availableDate     DateTime? // when result is ready
  reportFile        String? // Base64 encoded image/PDF or URL
  status            RequestStatus @default(REQUESTED)
  notes             String?

  patient         Patient         @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  dentist         Dentist         @relation(fields: [dentistId], references: [userId], onDelete: Cascade)
  radiologyCenter RadiologyCenter @relation(fields: [radiologyCenterId], references: [userId], onDelete: Cascade)
  treatment       Treatment?      @relation(fields: [treatmentId], references: [id])
}

// =======================
//         ENUMS
// =======================
enum UserRole {
  Admin
  Clinic
  Dentist
  Secretary
  Patient
  RadiologyCenter
}

enum UserStatus {
  ACTIVE
  PENDING
  REJECTED
  DEACTIVATED
  DELETED
}

enum Gender {
  Male
  Female
}

enum AppointmentStatus {
  CONFIRMED
  PENDING
  CANCELLED
  COMPLETED
}

enum TreatmentStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
}

enum RequestStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
